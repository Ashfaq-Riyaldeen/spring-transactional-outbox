# Image versions and host ports of docker-compose.yml, read by docker compose on its own.
# A variable set in the shell wins over this file: ORDERS_DB_PORT=15432 docker compose up -d
# The services expect the default ports; started on others, they need DB_PORT / KAFKA_BOOTSTRAP_SERVERS to match.

POSTGRES_VERSION=16-alpine
KAFKA_VERSION=3.8.1

ORDERS_DB_PORT=5432
NOTIFICATIONS_DB_PORT=5433
KAFKA_PORT=9092
