# Monitoring of the services started on the host from Maven or an IDE, for docker-compose.yml.
# A variable set in the shell wins over this file.
PROMETHEUS_TARGETS=host
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_OTLP_PORT=4318
OPENSEARCH_PORT=9200
# the JSON log files Fluent Bit tails: a directory next to the services on the host, the volume of the stack
SERVICE_LOGS=../logs
OPENSEARCH_DASHBOARDS_PORT=5601
