          "expr": "sum(rate(http_server_requests_seconds_count{application=\"order-service\", method=\"POST\", uri=\"/api/v1/orders\", status=\"201\"}[$__rate_interval]))",
          "legendFormat": "placed",
          "refId": "A",
          "range": true
