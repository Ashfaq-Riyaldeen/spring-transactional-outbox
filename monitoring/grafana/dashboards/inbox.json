    {
      "type": "timeseries",
      "title": "Inbox events",
      "description": "Per second: ids recorded for the first time, duplicates skipped and failed handling. An event whose handling fails after its id was recorded is counted as consumed as well, and again on each retry, since the rollback removes the id. A record that cannot be read moves neither: it shows in the listener results and the dead letter topic.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (rate(inbox_events_total{application=~\"$application\", type=~\"consumed|rejected_duplicates|failed\"}[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
