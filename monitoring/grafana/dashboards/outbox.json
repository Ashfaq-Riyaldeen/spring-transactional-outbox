    {
      "type": "stat",
      "title": "Pending",
      "description": "Events written by a business transaction and not yet taken by a poller, and those whose send failed waiting for their next retry. A value that keeps growing means the pollers do not keep up or Kafka is unreachable.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(outbox_events_by_event_type_and_status{application=~\"$application\", event_type=~\"$event_type\", status=\"pending\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
