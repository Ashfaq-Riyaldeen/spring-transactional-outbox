    {
      "type": "timeseries",
      "title": "Longest transaction and locks",
      "description": "The age of the oldest open transaction, and the locks held by mode at scrape time. The exporter's own AccessShareLock is always there; the pollers' SELECT ... FOR UPDATE SKIP LOCKED shows as RowShareLock and their writes as RowExclusiveLock only while a transaction is open, so a lock that stays is the one to look at.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (database) (pg_stat_activity_max_tx_duration{database=~\"$database\", datname=~\"$database\"})",
          "legendFormat": "{{database}} longest transaction",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (database, mode) (pg_locks_count{database=~\"$database\", datname=~\"$database\"}) > 0",
          "legendFormat": "{{database}} {{mode}}",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
