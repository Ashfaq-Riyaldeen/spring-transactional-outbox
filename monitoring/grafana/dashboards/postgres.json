    {
      "type": "timeseries",
      "title": "Connections by state",
      "description": "Active, idle and idle-in-transaction connections against max_connections. A pool keeps its idle connections open, so idle is expected; idle in transaction for long is not.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (database, state) (pg_stat_activity_count{database=~\"$database\", datname=~\"$database\", state!~\"disabled|fastpath function call\"})",
          "legendFormat": "{{database}} {{state}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (database) (pg_settings_max_connections{database=~\"$database\"})",
          "legendFormat": "{{database}} max",
          "refId": "B",
