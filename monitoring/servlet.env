# Monitoring of the servlet stack, for docker/compose.servlet.yml. Its host ports differ from monitoring/host.env,
# so both run at the same time. A variable set in the shell wins over this file.
PROMETHEUS_TARGETS=servlet
PROMETHEUS_PORT=9190
GRAFANA_PORT=3100
TEMPO_OTLP_PORT=4418
OPENSEARCH_PORT=9210
# the JSON log files Fluent Bit tails: a directory next to the services on the host, the volume of the stack
SERVICE_LOGS=service-logs
